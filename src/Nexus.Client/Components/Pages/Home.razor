@page "/"

@if (!_isConnected)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 100vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
        <MudText Typo="Typo.h6" Color="Color.Primary">@Lang.ConnectingToBackgroundService</MudText>

        @if (_connectionFailed)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @Lang.ServiceNotFoundWarning
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="RetryConnection">@Lang.Retry
            </MudButton>
        }
    </MudStack>
}
else
{
    <MudTabs Centered="true" Border="true" ApplyEffectsToContainer="true" TabHeaderClass="mx-auto home-tab-header"
             TabPanelsClass="pa-6" Color="Color.Primary">

        <MudTabPanel Text="@Lang.SystemStats" Icon="@Icons.Material.Filled.QueryStats">
            <StatsDisplay CurrentStats="@_currentStats" />
        </MudTabPanel>

        <MudTabPanel Text="@Lang.FanControl" Visible="_supportedFanModes != null && _supportedFanModes.Count > 1"
                     Icon="@Icons.Material.Filled.Air">
            <FanPanel SupportedModes="_supportedFanModes" CurrentStats="@_currentStats" />
        </MudTabPanel>

        <MudTabPanel Text="@Lang.MuxSwitch" Icon="@Icons.Material.Filled.DeveloperBoard" Visible="_isMuxSupported">
            <MuxPanel SupportedModes="_supportedMuxModes" CurrentStats="_currentStats" />
        </MudTabPanel>
    </MudTabs>
}