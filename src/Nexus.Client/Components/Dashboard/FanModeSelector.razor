<MudTabs Color="Color.Primary" Outlined="true" Ripple="true" ActivePanelIndex="(int)CurrentMode">
    <MudTabPanel Text="@Lang.Auto" Icon="@Icons.Material.Filled.AutoMode"
                 OnClick="() => OnModeChanged(FanMode.Auto)" />

    <MudTabPanel Text="@Lang.Manual" Disabled="@IsManualModeDisabled" Icon="@Icons.Material.Filled.Tune"
                 ToolTip="@(IsManualModeDisabled ? Lang.ManualModeDisabledTooltip : null)"
                 OnClick="() => OnModeChanged(FanMode.Manual)" />

    <MudTabPanel Text="@Lang.Max" Icon="@Icons.Material.Filled.RocketLaunch"
                 OnClick="() => OnModeChanged(FanMode.Max)" />
</MudTabs>